% rvcege.def -- "Continuous Internal Evaluation" template used by other departments / Global Electives
%   \begin{gepaper} \gehead \begin{getable} \gq{1.1}{text}{M}{BT}{CO} ... \end{getable} \end{gepaper}
\newcounter{gecount}
\newenvironment{gepaper}{\clearpage\stepcounter{gecount}\setcounter{page}{1}\pagestyle{rvcege}}{\par\label{ge-end-\thegecount}\clearpage}
\fancypagestyle{rvcege}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[R]{\small Page \thepage\ of \pageref{ge-end-\thegecount}}}
\newcommand{\gehead}{%
  \vspace*{-2.7cm}\noindent\begin{minipage}[c]{2.0cm}\rvcelogo[1.9cm]\end{minipage}\hfill
  \begin{minipage}[c]{14cm}\centering
   {\bfseries\fontsize{16}{19}\selectfont RV COLLEGE OF ENGINEERING\textsuperscript{\textregistered}, Bengaluru-59}\\[2pt]
   {\bfseries\small (Autonomous Institution Affiliated to VTU, Belagavi)}\end{minipage}\hspace{2cm}\par\vspace{6pt}
  \noindent\begingroup\renewcommand{\arraystretch}{1.45}\small
  \begin{tabular}{|p{2.5cm}|p{1.8cm}|p{3.0cm}|p{3.0cm}|p{3.6cm}|p{2.0cm}|}\hline
   \hfill\textbf{Program} & \multicolumn{5}{l|}{\getkey{program}}\\\hline
   \hfill\textbf{Course Title} & \multicolumn{5}{l|}{\getkey{title}}\\\hline
   \hfill\textbf{Course Code} & \multicolumn{5}{l|}{\getkey{code}}\\\hline
   \multicolumn{6}{|c|}{\getkey{exam}}\\\hline
   \multicolumn{6}{|c|}{\getkey{ggroup}}\\\hline
   \hfill Sem & \hfil\getkey{sem}\hfil & \multicolumn{2}{c|}{\textbf{Date $|$ Time}} & \multicolumn{2}{c|}{\hfil\textbf{\getkey{month}}\hfil}\\\hline
   \hfill Max Marks & \hfil\textbf{\getkey{maxmarks}}\hfil & \multicolumn{2}{c|}{\textbf{\getkey{gdate}\ $|$\ \getkey{mtime}}} & \hfil\textbf{Max Duration}\hfil & \hfil\textbf{\getkey{duration}}\hfil\\\hline
  \end{tabular}\endgroup\par\vspace{8pt}
  \noindent{\bfseries Instructions to Candidates:}\par\hspace*{0.8cm}\getkey{instr}\par\vspace{6pt}}
\newenvironment{getable}{%
  \begin{longtable}{|C{1.0cm}|p{12.1cm}|C{0.95cm}|C{0.95cm}|C{0.95cm}|}
  \hline \textbf{Q. No.} & \multicolumn{1}{c|}{\textbf{QUESTIONS}} & \textbf{M} & \textbf{BT} & \textbf{CO}\\ \hline
  \endfirsthead
  \endhead
}{\end{longtable}}
\newcommand{\gq}[5]{#1 & #2 & #3 & #4 & #5\\ \hline}
\newcommand{\gepart}[1]{\multicolumn{5}{|c|}{#1}\\ \hline}
\newcommand{\cotable}[2]{\par\vspace{6pt}\noindent{\fontsize{12}{14}\selectfont #1}\par\vspace{2pt}
  \noindent\begin{tabular}{|C{0.9cm}|p{15.3cm}|}\hline #2\\\hline\end{tabular}\par\vspace{8pt}}

% ---------------------------------------------------------------- other-department CIE ("Department of X" + Date/Test/Max Marks table)
\newenvironment{xpaper}{\clearpage\paperinfo{shownote=1,deptline={},note={Answer all the Questions.}}\pagestyle{rvce}}{}
\newenvironment{xpaperlogo}{\clearpage\pagestyle{rvce}}{}
\newcommand{\xhead}{%
  \par\vspace{2pt}\centerline{\bfseries\fontsize{14}{17}\selectfont \getkey{deptline}}\par\vspace{6pt}
  \noindent\begingroup\renewcommand{\arraystretch}{1.7}\bfseries\fontsize{11}{13}\selectfont
  \begin{tabular}{|p{5.4cm}|C{5.0cm}|p{5.8cm}|}\hline
   Date: \getkey{date} & \getkey{exam} & Max. Marks: \getkey{maxmarks}\\\hline
   Semester: \getkey{sem} & \getkey{prog} & Duration: \getkey{duration}\\\hline
   \multicolumn{2}{|p{10.6cm}|}{Course Title: \getkey{title}} & Course Code: \getkey{code}\\\hline
  \end{tabular}\endgroup\par\vspace{8pt}}
\newenvironment{xtable}[1]{%
  \begin{longtable}{|C{1.05cm}|p{12.2cm}|C{0.95cm}|C{0.95cm}|C{0.95cm}|}
  \hline
  \textbf{S No} & \multicolumn{1}{c|}{\textbf{#1}} & \textbf{M} & \textbf{BT} & \textbf{CO}\\ \hline
  \endfirsthead
  \endhead
}{\end{longtable}}
